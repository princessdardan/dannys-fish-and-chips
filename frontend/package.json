    "@sanity/icons": "^3.7.4",
    "@sanity/image-url": "^2.1.1",
    "@sanity/vision": "4.22.0",
    "@types/qs": "^6.14.0",
    "@vercel/analytics": "^1.6.1",
    "as": "^0.4.1",
    "class-variance-authority": "^0.7.1",
