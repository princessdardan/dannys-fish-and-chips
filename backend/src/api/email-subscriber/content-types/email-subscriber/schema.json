{
  "kind": "collectionType",
  "collectionName": "email_subscribers",
  "info": {
    "singularName": "email-subscriber",
    "pluralName": "email-subscribers",
    "displayName": "Email Subscriber",
    "description": "Collection of newsletter subscriber records."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "email": {
      "type": "email",
      "required": true,
      "unique": true,
      "description": "Subscriber email address (unique)."
    },
    "subscribedAt": {
      "type": "datetime",
      "description": "Timestamp of when the subscriber was added."
    },
    "source": {
      "type": "string",
      "default": "website",
      "description": "Source of the subscription (e.g., website, import)."
    }
  }
}
