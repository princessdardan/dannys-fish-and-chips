{
  "collectionName": "components_components_operating_hours",
  "info": {
    "displayName": "Operating Hours",
    "description": "Operating hours for a single day of the week"
  },
  "options": {},
  "attributes": {
    "day": {
      "type": "enumeration",
      "enum": [
        "Monday",
        "Tuesday",
        "Wednesday",
        "Thursday",
        "Friday",
        "Saturday",
        "Sunday"
      ],
      "required": true
    },
    "openTime": {
      "type": "string",
      "regex": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
      "required": false
    },
    "closeTime": {
      "type": "string",
      "regex": "^([01]?[0-9]|2[0-3]):[0-5][0-9]$",
      "required": false
    },
    "isClosed": {
      "type": "boolean",
      "default": false
    }
  }
}
