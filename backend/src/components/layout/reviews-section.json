    },
    "googlePlaceId": {
      "type": "string",
      "description": "Google Place ID for Google Reviews widget."
    },
    "tripAdvisorUrl": {
      "type": "string",
      "description": "TripAdvisor business URL for widget."
    }
  },
  "config": {}
}
